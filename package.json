{
  "name": "stream-utils",
  "private": true,
  "version": "0.1.0",
  "description": "Independent utilities for live streaming",
  "workspaces": ["projects/*"],
  "engines": { "node": ">=22.15.0" },
  "scripts": {
    "check": "node scripts/check.js",
